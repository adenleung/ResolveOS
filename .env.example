DATABASE_URL=postgresql+psycopg://resolve:resolve@localhost:5433/resolveos
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=ResolveOS
API_PREFIX=/api
API_VERSION=v1
ORCHESTRATION_DEV_AUTH_ENABLED=false
INVESTIGATOR_LIVE_ENABLED=false
# Set model, pinned version, environment credentials and verified pricing only
# when live synthetic inference is explicitly authorized. Defaults fail closed.
INVESTIGATOR_MODEL=
INVESTIGATOR_MODEL_VERSION=
INVESTIGATOR_TIMEOUT_SECONDS=20
INVESTIGATOR_MAX_ITERATIONS=4
INVESTIGATOR_MAX_TOOL_CALLS=12
INVESTIGATOR_TOKEN_BUDGET=16000
INVESTIGATOR_COST_BUDGET=0.10
ORCHESTRATION_LEASE_SECONDS=60
ORCHESTRATION_MAX_ATTEMPTS=3
ORCHESTRATION_POLL_LIMIT=100
